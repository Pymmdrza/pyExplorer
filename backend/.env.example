PYEXPLORER_ENVIRONMENT=local
PYEXPLORER_LOG_LEVEL=INFO
PYEXPLORER_API_PREFIX=/api/v1
PYEXPLORER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PYEXPLORER_REQUEST_TIMEOUT_SECONDS=10
PYEXPLORER_REQUEST_MAX_RETRIES=3
PYEXPLORER_PROVIDER_REQUEST_TIMEOUT_SECONDS=6
PYEXPLORER_PROVIDER_MAX_RETRIES=1
PYEXPLORER_RETRY_BACKOFF_SECONDS=0.4
PYEXPLORER_CACHE_STATS_TTL_SECONDS=120
PYEXPLORER_CACHE_RESOURCE_TTL_SECONDS=600
PYEXPLORER_CACHE_MAX_ENTRIES=512
PYEXPLORER_HTTP_MAX_CONNECTIONS=24
PYEXPLORER_HTTP_MAX_KEEPALIVE_CONNECTIONS=12
PYEXPLORER_PROVIDER_FAILURE_THRESHOLD=3
PYEXPLORER_PROVIDER_COOLDOWN_SECONDS=20
PYEXPLORER_REALTIME_ENABLED=true
PYEXPLORER_BLOCKCHAIN_WS_URL=wss://ws.blockchain.info/inv
PYEXPLORER_REALTIME_QUEUE_SIZE=200
PYEXPLORER_REALTIME_SUBSCRIBER_QUEUE_SIZE=32
